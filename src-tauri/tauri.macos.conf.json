{
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true
    }
  },
  "app": {
    "windows": [
      {
        "title": "Rushes",
        "width": 1260,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "backgroundColor": "#08090a",
        "label": "main",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  }
}
