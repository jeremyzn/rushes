{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Rushes desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "**" }, { "path": "$HOME/**" }, { "path": "$DOWNLOAD/**" }] },
    { "identifier": "opener:allow-reveal-item-in-dir", "allow": [{ "path": "**" }, { "path": "$HOME/**" }, { "path": "$DOWNLOAD/**" }] },
    "opener:allow-open-url",
    "os:default",
    "notification:default",
    "updater:default",
    "process:allow-restart"
  ]
}
